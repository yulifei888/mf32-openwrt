#!/bin/sh
# MF32 WiFi 状态灯：blue:wlan
LED="/sys/class/leds/blue:wlan"
[ -d "$LED" ] || exit 0
MAX=$(cat "$LED/max_brightness" 2>/dev/null); [ -z "$MAX" ] && MAX=1
case "$ACTION" in
  add)
    [ "$DEVICENAME" = "phy0" ] || exit 0
    echo none > "$LED/trigger" 2>/dev/null
    echo "$MAX" > "$LED/brightness" 2>/dev/null
    ;;
  remove)
    [ "$DEVICENAME" = "phy0" ] || exit 0
    echo none > "$LED/trigger" 2>/dev/null
    echo 0 > "$LED/brightness" 2>/dev/null
    ;;
esac
